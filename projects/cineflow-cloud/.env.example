CINEFLOW_MODE=demo
CINEFLOW_TARGET_PROCESSING_SECONDS=300
CINEFLOW_MAX_VIDEO_SECONDS=300
CINEFLOW_MAX_INPUT_BYTES=536870912
CINEFLOW_MAX_INFLIGHT_JOBS=2

# This project does not upload to OSS or remove burned subtitles. The existing
# upstream client supplies input_url and, when available, clean_video_url.
# Preferred worker endpoints should use Alibaba Cloud APIs/adapters first;
# secondary endpoints can use Volcengine adapters when Alibaba Cloud is not
# suitable for that stage.
CINEFLOW_MEDIA_WORKER_URL=
CINEFLOW_SECONDARY_MEDIA_WORKER_URL=
CINEFLOW_ASR_WORKER_URL=
CINEFLOW_SECONDARY_ASR_WORKER_URL=
CINEFLOW_SPEAKER_WORKER_URL=
CINEFLOW_SECONDARY_SPEAKER_WORKER_URL=

# DeepSeek is the only/default subtitle translator in this release. These
# defaults mirror the existing pyVideoTrans DeepSeek channel without importing it.
CINEFLOW_TRANSLATION_PROVIDER=deepseek
CINEFLOW_DEEPSEEK_API_KEY=
CINEFLOW_DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
CINEFLOW_DEEPSEEK_MODEL=deepseek-v4-flash
CINEFLOW_DEEPSEEK_MAX_TOKENS=65536
CINEFLOW_DEEPSEEK_THINKING=false

# Azure Speech primary and optional secondary region for failover.
CINEFLOW_AZURE_SPEECH_KEY=
CINEFLOW_AZURE_SPEECH_REGION=
CINEFLOW_AZURE_SPEECH_SECONDARY_KEY=
CINEFLOW_AZURE_SPEECH_SECONDARY_REGION=
CINEFLOW_AZURE_TTS_CONCURRENCY=8

# Internal service authentication.
CINEFLOW_WORKER_BEARER_TOKEN=

# Billing guardrails for work owned by this service. OSS upload and subtitle
# removal are upstream and are not included here.
CINEFLOW_COST_ASR_PER_SECOND=0.00022
CINEFLOW_COST_TRANSLATION_PER_CHARACTER=0.000003
CINEFLOW_COST_AZURE_TTS_PER_CHARACTER=0.0000954
CINEFLOW_COST_GPU_PER_SECOND=0.0062
CINEFLOW_COST_RENDER_PER_MINUTE=0.0651
CINEFLOW_COST_SEPARATION_PER_MINUTE=0.10

# CineFusion GPU worker. Use demo only for contract tests.
CINEFLOW_SPEAKER_MODE=demo
CINEFLOW_SPEAKER_HF_TOKEN=
CINEFLOW_SPEAKER_PYANNOTE_MODEL=pyannote/speaker-diarization-community-1
CINEFLOW_SPEAKER_DEVICE=cuda
CINEFLOW_SPEAKER_ACTIVE_SPEAKER_COMMAND=
CINEFLOW_SPEAKER_HOST=0.0.0.0
CINEFLOW_SPEAKER_PORT=8090
