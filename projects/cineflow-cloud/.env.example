CINEFLOW_MODE=demo
CINEFLOW_TARGET_PROCESSING_SECONDS=300
CINEFLOW_MAX_VIDEO_SECONDS=300
CINEFLOW_MAX_INPUT_BYTES=536870912
CINEFLOW_MAX_INFLIGHT_JOBS=2

# Control-plane worker endpoints. Five minutes is a soft optimization target;
# individual cloud-worker timeouts are failure guards, not a 300-second cancel.
CINEFLOW_MEDIA_WORKER_URL=http://media-aliyun:8093
CINEFLOW_SECONDARY_MEDIA_WORKER_URL=
CINEFLOW_MEDIA_WORKER_TIMEOUT_SECONDS=900
CINEFLOW_ASR_WORKER_URL=http://asr-aliyun:8091
CINEFLOW_SECONDARY_ASR_WORKER_URL=http://asr-volcengine:8091
CINEFLOW_ASR_WORKER_TIMEOUT_SECONDS=300
CINEFLOW_SPEAKER_WORKER_URL=http://speaker-worker:8090
CINEFLOW_SECONDARY_SPEAKER_WORKER_URL=
CINEFLOW_SPEAKER_WORKER_TIMEOUT_SECONDS=300

# DeepSeek is the only/default subtitle translator in this release.
CINEFLOW_TRANSLATION_PROVIDER=deepseek
CINEFLOW_DEEPSEEK_API_KEY=
CINEFLOW_DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
CINEFLOW_DEEPSEEK_MODEL=deepseek-v4-flash
CINEFLOW_DEEPSEEK_MAX_TOKENS=65536
CINEFLOW_DEEPSEEK_THINKING=false

# Azure Speech primary and optional secondary region. CineFlow requests RIFF PCM,
# measures every clip, and performs bounded SSML-rate fitting without clipping.
CINEFLOW_AZURE_SPEECH_KEY=
CINEFLOW_AZURE_SPEECH_REGION=
CINEFLOW_AZURE_SPEECH_SECONDARY_KEY=
CINEFLOW_AZURE_SPEECH_SECONDARY_REGION=
CINEFLOW_AZURE_TTS_CONCURRENCY=8
CINEFLOW_AZURE_TTS_MAX_FIT_RATE_PERCENT=55
CINEFLOW_AZURE_TTS_DURATION_TOLERANCE_RATIO=1.08
CINEFLOW_AZURE_TTS_MAX_FIT_ATTEMPTS=2
CINEFLOW_AZURE_TTS_REQUEST_TIMEOUT_SECONDS=25

# Internal service authentication. Use different high-entropy values in production
# when services are exposed outside one private service mesh.
CINEFLOW_WORKER_BEARER_TOKEN=
CINEFLOW_UPLOAD_BEARER_TOKEN=
CINEFLOW_SUBTITLE_BEARER_TOKEN=

# Billing guardrails for translation/ASR/TTS/media stages. Source upload and
# subtitle removal expose their own provider usage and are accounted separately.
CINEFLOW_COST_ASR_PER_SECOND=0.00022
CINEFLOW_COST_TRANSLATION_PER_CHARACTER=0.000003
CINEFLOW_COST_AZURE_TTS_PER_CHARACTER=0.0000954
CINEFLOW_COST_GPU_PER_SECOND=0.0062
CINEFLOW_COST_RENDER_PER_MINUTE=0.0651
CINEFLOW_COST_SEPARATION_PER_MINUTE=0.10

# -----------------------------------------------------------------------------
# Source-video OSS upload Worker: STS, multipart/resume, object validation,
# abort, stale-session cleanup, and signed result URLs.
# -----------------------------------------------------------------------------
CINEFLOW_UPLOAD_HOST=0.0.0.0
CINEFLOW_UPLOAD_PORT=8094
CINEFLOW_UPLOAD_STATE_DIR=/var/lib/cineflow/uploads
CINEFLOW_UPLOAD_MAX_FILE_BYTES=21474836480
CINEFLOW_UPLOAD_CREDENTIAL_DURATION_SECONDS=3600
CINEFLOW_UPLOAD_STALE_SESSION_SECONDS=86400

CINEFLOW_UPLOAD_ALIYUN_REGION=cn-beijing
CINEFLOW_UPLOAD_ALIYUN_ROLE_ARN=
CINEFLOW_UPLOAD_ALIYUN_STS_ENDPOINT=
CINEFLOW_UPLOAD_ALIYUN_ACCESS_KEY_ID=
CINEFLOW_UPLOAD_ALIYUN_ACCESS_KEY_SECRET=
CINEFLOW_UPLOAD_ALIYUN_SECURITY_TOKEN=

CINEFLOW_UPLOAD_OSS_ENDPOINT=https://oss-cn-beijing.aliyuncs.com
CINEFLOW_UPLOAD_OSS_BUCKET=
CINEFLOW_UPLOAD_OSS_SOURCE_PREFIX=cineflow/sources
CINEFLOW_UPLOAD_OSS_SIGNED_URL_TTL_SECONDS=86400

# Desktop/CLI token used when calling the Upload Worker.
CINEFLOW_UPLOAD_CLIENT_TOKEN=

# -----------------------------------------------------------------------------
# Subtitle-removal Worker. AUTO routes in the configured order: Alibaba
# VideoDetext, Caca, then a trusted local command. State survives restarts.
# -----------------------------------------------------------------------------
CINEFLOW_SUBTITLE_HOST=0.0.0.0
CINEFLOW_SUBTITLE_PORT=8095
CINEFLOW_SUBTITLE_STATE_DIR=/var/lib/cineflow/subtitles
CINEFLOW_SUBTITLE_MAX_CONCURRENCY=2
CINEFLOW_SUBTITLE_PROVIDER_ORDER=aliyun,caca,local
CINEFLOW_SUBTITLE_STALE_JOB_SECONDS=604800
CINEFLOW_SUBTITLE_MAX_REMOTE_COPY_BYTES=21474836480
CINEFLOW_SUBTITLE_FFPROBE_BINARY=ffprobe
CINEFLOW_SUBTITLE_FFPROBE_TIMEOUT_SECONDS=120
CINEFLOW_SUBTITLE_DURATION_TOLERANCE_SECONDS=1.5
CINEFLOW_SUBTITLE_FPS_TOLERANCE=1.0
CINEFLOW_SUBTITLE_DELETE_INVALID_OUTPUT=true

CINEFLOW_SUBTITLE_ALIYUN_REGION=cn-beijing
CINEFLOW_SUBTITLE_ALIYUN_ACCESS_KEY_ID=
CINEFLOW_SUBTITLE_ALIYUN_ACCESS_KEY_SECRET=
CINEFLOW_SUBTITLE_ALIYUN_SECURITY_TOKEN=
CINEFLOW_SUBTITLE_ALIYUN_CONNECT_TIMEOUT_SECONDS=15
CINEFLOW_SUBTITLE_ALIYUN_REQUEST_TIMEOUT_SECONDS=60
CINEFLOW_SUBTITLE_ALIYUN_POLL_INTERVAL_SECONDS=1
CINEFLOW_SUBTITLE_ALIYUN_JOB_TIMEOUT_SECONDS=1800
CINEFLOW_SUBTITLE_ALIYUN_DEFAULT_MODEL_ID=algo-video-detext-new

CINEFLOW_SUBTITLE_OSS_ENDPOINT=https://oss-cn-beijing.aliyuncs.com
CINEFLOW_SUBTITLE_OSS_BUCKET=
CINEFLOW_SUBTITLE_OSS_PREFIX=cineflow/subtitle-removal
CINEFLOW_SUBTITLE_OSS_SIGNED_URL_TTL_SECONDS=86400

# Caca endpoint names vary by deployment, so every path and auth field is
# configurable. Validate these values against the account currently used by the
# existing application before enabling Caca in the provider order.
CINEFLOW_SUBTITLE_CACA_BASE_URL=
CINEFLOW_SUBTITLE_CACA_API_KEY=
CINEFLOW_SUBTITLE_CACA_SUBMIT_PATH=/v1/video/remove-subtitles
CINEFLOW_SUBTITLE_CACA_STATUS_PATH=/v1/tasks/{task_id}
CINEFLOW_SUBTITLE_CACA_CANCEL_PATH=
CINEFLOW_SUBTITLE_CACA_AUTH_HEADER=Authorization
CINEFLOW_SUBTITLE_CACA_AUTH_SCHEME=Bearer
CINEFLOW_SUBTITLE_CACA_JOB_TIMEOUT_SECONDS=1800

# Trusted server-side local command. Never accept this template from API callers.
# Placeholders: {input} {output} {regions} {time_ranges} {workdir}
CINEFLOW_SUBTITLE_LOCAL_COMMAND=
CINEFLOW_SUBTITLE_LOCAL_TIMEOUT_SECONDS=1800

# -----------------------------------------------------------------------------
# Alibaba ICE Media Worker for audio extraction, MusicDemix, generated artifacts,
# Azure clips, subtitle delivery, and final assembly.
# -----------------------------------------------------------------------------
CINEFLOW_MEDIA_HOST=0.0.0.0
CINEFLOW_MEDIA_PORT=8093
CINEFLOW_MEDIA_MAX_CONCURRENCY=4
CINEFLOW_MEDIA_BEARER_TOKEN=
CINEFLOW_MEDIA_MAX_ARTIFACT_BYTES=33554432
CINEFLOW_MEDIA_ALIYUN_REGION=cn-beijing
CINEFLOW_MEDIA_ALIYUN_ACCESS_KEY_ID=
CINEFLOW_MEDIA_ALIYUN_ACCESS_KEY_SECRET=
CINEFLOW_MEDIA_ALIYUN_SECURITY_TOKEN=
CINEFLOW_MEDIA_ALIYUN_CONNECT_TIMEOUT_SECONDS=15
CINEFLOW_MEDIA_ALIYUN_REQUEST_TIMEOUT_SECONDS=60
CINEFLOW_MEDIA_ALIYUN_POLL_INTERVAL_SECONDS=1
CINEFLOW_MEDIA_ALIYUN_JOB_TIMEOUT_SECONDS=900
CINEFLOW_MEDIA_OSS_ENDPOINT=https://oss-cn-beijing.aliyuncs.com
CINEFLOW_MEDIA_OSS_BUCKET=
CINEFLOW_MEDIA_OSS_PREFIX=cineflow/generated
CINEFLOW_MEDIA_OSS_SIGNED_URL_TTL_SECONDS=86400
CINEFLOW_MEDIA_BACKGROUND_GAIN=0.25
CINEFLOW_MEDIA_OUTPUT_BITRATE_KBPS=3000
CINEFLOW_MEDIA_HARD_SUBTITLE_FONT=Alibaba PuHuiTi
CINEFLOW_MEDIA_HARD_SUBTITLE_FONT_SIZE=54
CINEFLOW_MEDIA_HARD_SUBTITLE_Y=0.88
CINEFLOW_MEDIA_HARD_SUBTITLE_TEXT_WIDTH=0.9
CINEFLOW_MEDIA_HARD_SUBTITLE_OUTLINE=2

# Standard Alibaba credential names are accepted as server-side fallbacks.
ALIBABA_CLOUD_ACCESS_KEY_ID=
ALIBABA_CLOUD_ACCESS_KEY_SECRET=
ALIBABA_CLOUD_SECURITY_TOKEN=

# -----------------------------------------------------------------------------
# ASR Workers. Alibaba Fun-ASR is primary; Volcengine BigModel Flash is fallback.
# -----------------------------------------------------------------------------
CINEFLOW_ASR_BACKEND=aliyun
CINEFLOW_ASR_HOST=0.0.0.0
CINEFLOW_ASR_PORT=8091
CINEFLOW_ASR_MAX_CONCURRENCY=4

CINEFLOW_ASR_ALIYUN_API_KEY=
CINEFLOW_ASR_ALIYUN_WORKSPACE_ID=
CINEFLOW_ASR_ALIYUN_REGION=cn-beijing
CINEFLOW_ASR_ALIYUN_BASE_URL=
CINEFLOW_ASR_ALIYUN_MODEL=fun-asr
CINEFLOW_ASR_ALIYUN_POLL_INTERVAL_SECONDS=0.75
CINEFLOW_ASR_ALIYUN_TASK_TIMEOUT_SECONDS=240

CINEFLOW_ASR_VOLCENGINE_API_KEY=
CINEFLOW_ASR_VOLCENGINE_APP_ID=
CINEFLOW_ASR_VOLCENGINE_ACCESS_TOKEN=
CINEFLOW_ASR_VOLCENGINE_ENDPOINT=https://openspeech.bytedance.com/api/v3/auc/bigmodel/recognize/flash
CINEFLOW_ASR_VOLCENGINE_RESOURCE_ID=volc.bigasr.auc_turbo
CINEFLOW_ASR_VOLCENGINE_MODEL_VERSION=400
CINEFLOW_ASR_VOLCENGINE_FFMPEG_BINARY=ffmpeg
CINEFLOW_ASR_VOLCENGINE_ATTEMPTS=3

# CineFusion GPU Worker. Cloud ASR speaker labels are preferred; pyannote is a
# fallback when ASR does not return speaker_id.
CINEFLOW_SPEAKER_MODE=demo
CINEFLOW_SPEAKER_AUDIO_BACKEND=auto
CINEFLOW_SPEAKER_ASR_TURN_CONFIDENCE=0.90
CINEFLOW_SPEAKER_HF_TOKEN=
CINEFLOW_SPEAKER_PYANNOTE_MODEL=pyannote/speaker-diarization-community-1
CINEFLOW_SPEAKER_DEVICE=cuda
CINEFLOW_SPEAKER_ACTIVE_SPEAKER_COMMAND=
CINEFLOW_SPEAKER_HOST=0.0.0.0
CINEFLOW_SPEAKER_PORT=8090
