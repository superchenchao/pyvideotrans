FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates ffmpeg \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY pyproject.toml README.md ./
COPY cineflow ./cineflow
RUN pip install --no-cache-dir '.[aliyun]'

RUN mkdir -p /var/lib/cineflow/subtitles
VOLUME ["/var/lib/cineflow/subtitles"]

EXPOSE 8095
CMD ["uvicorn", "cineflow.subtitle_worker:app", "--host", "0.0.0.0", "--port", "8095"]
